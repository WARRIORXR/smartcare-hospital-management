# ============================================================
# SmartCare – Backend Environment Variables
# ============================================================
# HOW TO USE:
#   1. Copy this file: copy .env.example .env
#   2. In production (Render), set these in the Render Dashboard
#   3. Never commit .env to git
# ============================================================

SECRET_KEY=django-insecure-smartcare-replace-this-with-a-long-random-string-123abc
DEBUG=True

# Allowed hosts (comma-separated, include .onrender.com for Render)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Selection: 'sqlite', 'postgresql', or 'mysql'
DB_ENGINE=sqlite

# Render PostgreSQL connection string (automatically provided by Render if using render.yaml)
# DATABASE_URL=postgresql://user:password@host/dbname

# Production Frontend URL (Cloudflare Pages) for CORS
# FRONTEND_URL=https://smartcare-hospital.pages.dev

# Local MySQL settings (if DB_ENGINE=mysql)
DB_NAME=smartcare_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
