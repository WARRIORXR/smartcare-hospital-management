# .env — Backend environment variables
# Copy this to backend/.env and fill in your values
# DO NOT commit the actual .env to git (it's in .gitignore)

SECRET_KEY=django-insecure-replace-with-a-strong-random-key
DEBUG=True

DB_NAME=smartcare_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
