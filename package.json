{
  "name": "smartcare-hospital",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:frontend": "npm --prefix frontend run build",
    "build:worker": "esbuild worker/src/index.ts --bundle --format=esm --platform=browser --conditions=workerd,worker --outfile=frontend/dist/_worker.js",
    "build": "npm run build:frontend && npm run build:worker",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply smartcare-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply smartcare-db --remote"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "4.168.0"
  }
}
